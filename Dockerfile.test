FROM node:22-alpine

# Install Chromium (Optional if using JSDOM, but keeping if user moves to browser testing)
RUN apk add --no-cache chromium

# Set CHROME_BIN
ENV CHROME_BIN=/usr/bin/chromium-browser

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source
COPY . .

# Run Tests (Vitest)
# Use 'run' to execute once and exit
CMD ["npm", "run", "test:ci"]
