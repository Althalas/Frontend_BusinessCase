{
    "name": "electricity-business-frontend",
    "version": "1.0.0",
    "scripts": {
        "ng": "ng",
        "start": "node set-env.js && ng serve",
        "build": "node set-env.js && ng build",
        "watch": "ng build --watch --configuration development",
        "test": "node set-env.js && vitest",
        "test:watch": "vitest",
        "test:ci": "node set-env.js && vitest run",
        "lint": "ng lint",
        "e2e": "node set-env.js && cypress open",
        "e2e:headless": "node set-env.js && cypress run",
        "e2e:ci": "cypress run --browser chrome",
        "e2e:docker:up": "cd .. && docker compose -f docker-compose.e2e.yml up -d --build",
        "e2e:docker:down": "cd .. && docker compose -f docker-compose.e2e.yml down -v",
        "e2e:docker:logs": "cd .. && docker compose -f docker-compose.e2e.yml logs -f",
        "e2e:docker:run": "npm run e2e:docker:up && npx wait-on http://localhost:4200 http://localhost:3000/api/docs --timeout 120000 && npm run e2e:headless",
        "test:all": "npm run test:ci && npm run e2e:docker:run"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^21.0.0",
        "@angular/cdk": "^21.0.0",
        "@angular/common": "^21.0.0",
        "@angular/compiler": "^21.0.0",
        "@angular/core": "^21.0.0",
        "@angular/forms": "^21.0.0",
        "@angular/google-maps": "^21.0.0",
        "@angular/material": "^21.0.0",
        "@angular/platform-browser": "^21.0.0",
        "@angular/platform-browser-dynamic": "^21.0.0",
        "@angular/router": "^21.0.0",
        "@stripe/stripe-js": "^5.0.0",
        "@types/leaflet": "^1.9.21",
        "chart.js": "^4.4.0",
        "leaflet": "^1.9.4",
        "ng2-charts": "^6.0.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.8.0"
    },
    "devDependencies": {
        "@analogjs/vitest-angular": "^1.10.0",
        "@angular-devkit/build-angular": "^21.0.0",
        "@angular-eslint/builder": "21.0.0",
        "@angular-eslint/eslint-plugin": "21.0.0",
        "@angular-eslint/eslint-plugin-template": "21.0.0",
        "@angular-eslint/schematics": "21.0.0",
        "@angular-eslint/template-parser": "21.0.0",
        "@angular/build": "^21.0.0",
        "@angular/cli": "^21.0.0",
        "@angular/compiler-cli": "^21.0.0",
        "@types/node": "^25.0.3",
        "@typescript-eslint/eslint-plugin": "^8.50.1",
        "@typescript-eslint/parser": "^8.50.1",
        "@vitest/coverage-v8": "^4.0.16",
        "angular-eslint": "^21.0.0",
        "cypress": "^15.8.1",
        "cypress-localstorage-commands": "^2.2.8",
        "dotenv": "^17.2.3",
        "eslint": "^9.16.0",
        "jsdom": "^25.0.0",
        "typescript": "~5.9.0",
        "vite": "^7.3.0",
        "vite-tsconfig-paths": "^6.0.3",
        "vitest": "^4.0.0",
        "wait-on": "^8.0.3",
        "zone.js": "^0.16.0"
    },
    "overrides": {
        "@typescript-eslint/parser": {
            "typescript": "$typescript"
        },
        "@typescript-eslint/eslint-plugin": {
            "typescript": "$typescript"
        },
        "eslint": "$eslint",
        "qs": "^6.14.1"
    }
}